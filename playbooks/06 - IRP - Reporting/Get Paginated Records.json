        {
            "@type": "WorkflowStep",
            "name": "Set Result",
            "description": null,
            "arguments": {
                "batchOutput": "{%- set recordsToSave = vars.steps.Run_Query.data['hydra:member'] -%}\n{%- set columns = recordsToSave[0].keys() -%}\n{%- set _result = [] -%}\n{%- for record in recordsToSave -%}\n    {%- set valDict = {} -%}\n    {%- for key in columns -%}\n        {%- set val = record[key] -%}\n        {%- if val | type_debug == 'dict' -%}\n            {%- set recordType = val.get('@type') -%}\n            {%- if recordType == 'Picklist' -%}\n                {%- set _ = valDict.update({ key : val['itemValue'] | string }) -%}\n            {%- elif recordType == 'Person' -%}\n                {%- set _ = valDict.update({ key : val['firstname'] ~ ' ' ~ val['lastname'] }) -%}\n            {%- elif recordType == 'Appliance' -%}\n                {%- set _ = valDict.update({ key : val['name'] }) -%}\n            {%- endif -%}\n        {%- elif key in vars.input.params.datetimeFieldsToConvert and val -%}\n            {%- set _ = valDict.update({ key : '%Y-%m-%d %H:%M:%S %Z' | strftime(val) }) -%}\n        {%- elif key in vars.input.params.queryBody['__selectFields'] -%}\n            {%- set _ = valDict.update({ key : val | string }) -%}\n        {%- endif -%}\n    {%- endfor -%}\n{%- do _result.append(valDict) -%}\n{%- endfor -%}{{_result}}"
            },
            "status": null,
            "top": "300",
            "left": "125",
            "stepType": "\/api\/3\/workflow_step_types\/04d0cf46-b6a8-42c4-8683-60a7eaa69e8f",
            "group": null,
            "uuid": "09350079-dfb0-4c5c-8a62-5889e4e5ab9b"
        },
